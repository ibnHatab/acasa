# The Raspberry Pi kiosk (ha-pi-kiosk's /etc/ha-pi-kiosk/config.env), applied by cmd/ha-ui -kiosk.
# Nina's dashboard on the 7-inch HDMI screen (1024x600, USB touch).
KIOSK_URL=http://homeassistant.local:8123/nina-panel/home?kiosk
DISPLAY_OUTPUT=HDMI-A-1
DISPLAY_ROTATION=normal
KIOSK_USER=nina
# the idle dimming drives the official DSI display's backlight: an HDMI screen has none
IDLE_ENABLED=0
IDLE_DIM_SEC=120
IDLE_OFF_SEC=300
IDLE_DIM_PERCENT=20
