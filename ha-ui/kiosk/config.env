# The Raspberry Pi kiosk (ha-pi-kiosk's /etc/ha-pi-kiosk/config.env), applied by cmd/ha-ui -kiosk.
# Nina's dashboard on the 7-inch HDMI screen (1024x600, USB touch).
KIOSK_URL="http://homeassistant.local:8123/nina-panel/home?kiosk"   # quoted: the file is sourced as shell (an & would end it)
DISPLAY_OUTPUT=HDMI-A-2   # the panel is on the Pi's second HDMI port
DISPLAY_ROTATION=normal
KIOSK_USER=nina
# idle: the official DSI display dims through its backlight; this HDMI one only goes off (backlight-control.sh)
IDLE_ENABLED=1   # HDMI: no dimming; off after IDLE_OFF_SEC through wlr-randr (backlight-control.sh), and Firefox stops drawing Nina's face
IDLE_DIM_SEC=120
IDLE_OFF_SEC=300
IDLE_DIM_PERCENT=20
